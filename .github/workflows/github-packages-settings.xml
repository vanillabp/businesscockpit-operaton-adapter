<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the workflows of this repository give Maven. Two servers, and both read their credentials
  from environment variables, which only the steps that need them set:

  - 'vanillabp-central' is the server of the profile 'central-portal' in
    io.vanillabp:release-parent. A push to main publishes the snapshots with it, and the release
    publishes with it. A file given with '-s' replaces the one actions/setup-java writes, so the
    server is named here again.
  - 'camunda-community-hub-vanillabp-camunda7-adapter' is the GitHub Packages registry of the
    Camunda 7 adapter. The module migration-tests runs that adapter next to this extension, and
    its snapshots are only there. The module's pom.xml names the registry under this id. GitHub
    Packages asks for a token even for a public package, so the server carries the repository
    secrets VANILLABP_USER_NAME and VANILLABP_USER_TOKEN, a token with 'read:packages'. This goes
    away once the Camunda 7 adapter has a release on Maven Central.

  Everything else comes from Maven Central and its snapshot repository, which need no login: the
  platform, the cockpit's extensions-commons, the Camunda 7 extension and the Operaton adapter.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>vanillabp-central</id>
            <username>${env.MAVEN_USERNAME}</username>
            <password>${env.MAVEN_PASSWORD}</password>
        </server>
        <server>
            <id>camunda-community-hub-vanillabp-camunda7-adapter</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
    </servers>
</settings>
